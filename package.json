{
  "name": "anthro-collect",
  "private": true,
  "version": "0.0.1",
  "description": "Anthro Collect: field data app for a student research project at Ashesi University",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "build": "node scripts/copy-mediapipe.mjs && tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run supabase/tests",
    "preview:worker": "npm run build && wrangler dev",
    "check:worker": "wrangler deploy --dry-run",
    "db:push": "supabase db push",
    "predev": "node scripts/copy-mediapipe.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261103.1": true
  }
}
