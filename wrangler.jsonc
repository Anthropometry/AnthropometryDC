{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anthro-collect",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Static PWA from dist/; the Worker runs first only for /api/*.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Two private buckets. Create once with:
  //   npx wrangler r2 bucket create anthro-collect-photos
  //   npx wrangler r2 bucket create anthro-collect-signatures
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "anthro-collect-photos" },
    { "binding": "SIGNATURES", "bucket_name": "anthro-collect-signatures" }
  ],
  // Public values only (the publishable key is safe to ship). Never put the secret key here.
  "vars": {
    "SUPABASE_URL": "https://vafxojfaylrlgupvahdo.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_m63_dG7p7oOIpnPqXwJjNQ_pAZ_hMzl"
  }
}
